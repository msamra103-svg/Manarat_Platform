{
  "version": 2,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/admin.html"
    },
    {
      "source": "/teacher",
      "destination": "/teacher/dashboard.html"
    },
    {
      "source": "/player",
      "destination": "/player/game.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    }
  ],
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/auth-legacy.html",
      "destination": "/auth.html",
      "permanent": false
    },
    {
      "source": "/teacher/dashboard-legacy.html",
      "destination": "/teacher/dashboard.html",
      "permanent": false
    },
    {
      "source": "/assets/manarat-logo.svg",
      "destination": "/assets/school-mark.svg",
      "permanent": false
    },
    {
      "source": "/assets/manarat-mark.svg",
      "destination": "/assets/school-mark.svg",
      "permanent": false
    }
  ]
}
