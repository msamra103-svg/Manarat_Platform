{
  "name": "horse-jumping-race",
  "version": "1.0.0",
  "description": "سباق الخيل — قفز الحواجز — لعبة تعليمية ثلاثية الأبعاد",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "test": "node tests/raceModel.test.mjs && node tests/bridge.test.mjs",
    "test:e2e": "python3 tests/e2e/scenarios.py docs/test-artifacts outcomes,refusal,pause,replay,touch,layouts,localsim,platform",
    "serve": "python3 -m http.server 8080 --directory dist-platform-sim",
    "sculpt": "node tools/sculpt/build-horse.mjs && node tools/sculpt/build-jockey.mjs && node tools/sculpt/build-people.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.187.0"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0"
  }
}
